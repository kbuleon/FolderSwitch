<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup Label="Tools">
    <!-- tools/FolderSwitch.DemoGif: encodes the README's animated tour (not shipped with the application). -->
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
  </ItemGroup>

</Project>
