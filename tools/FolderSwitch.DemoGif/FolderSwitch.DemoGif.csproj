<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- The icon's drawing is the application's own (its title bars draw it too): one definition, compiled here as is. -->
    <Compile Include="..\..\src\FolderSwitch.App\Views\AppIconDrawing.cs" Link="AppIconDrawing.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
  </ItemGroup>

  <ItemGroup>
    <!-- The captions of each language, read next to the executable. -->
    <None Update="Captions\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
