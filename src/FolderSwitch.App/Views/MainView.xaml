<!--
    The whole content of the main window, bound to MainViewModel (spec 5.2), from top to bottom: the title bar, the tab
    bar, the board of the active tab (scrolling past the screen's work area) and the context line. Hosted by MainWindow,
    and rendered off-screen by the snapshot mode.
    Customize mode adds to the title bar ⚙ (the settings panel) and « ◐ Theme · Mode ▾ » (the appearance menu); those,
    the « + Folder ▾ » menu and the palette open in the flyout declared here (see Flyout). The adorner layer at the
    top carries the insertion line of a drag and drop over the tab bar (the board's scroller has its own).
-->
<UserControl x:Class="FolderSwitch.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderSwitch.App.Views"
             xmlns:layout="clr-namespace:FolderSwitch.App.Views.Layout"
             x:Name="Root"
             FontFamily="Segoe UI"
             FontSize="13"
             Foreground="{DynamicResource Fs.OnBackgroundText}">
    <AdornerDecorator>
        <Grid>
            <DockPanel>
                <!-- Title bar: icon and name; on the right ⚙ and the appearance button (Customize mode only), « Customize » and ✕. -->
                <DockPanel DockPanel.Dock="Top" Margin="16,9,10,6">
                    <Button DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Style="{StaticResource Fs.CloseButton}"
                            Command="{Binding CloseCommand}"
                            ToolTip="{Binding Texts[Window.Close], ElementName=Root}"
                            AutomationProperties.Name="{Binding Texts[Window.Close], ElementName=Root}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Fs.CustomizeButton}" Command="{Binding ToggleCustomizeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Fs.IconFont}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE713;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomizing}" Value="True">
                                                <Setter Property="Text" Value="&#xE73E;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <layout:TextRoom VerticalAlignment="Center">
                                <TextBlock Text="{Binding CustomizeLabel}" />
                            </layout:TextRoom>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AppearanceButton"
                            DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            Style="{StaticResource Fs.ChromeButton}"
                            Visibility="{Binding IsCustomizing, Converter={StaticResource Fs.BoolToVisibility}}"
                            AutomationProperties.Name="{Binding Texts[Window.Appearance], ElementName=Root}"
                            Click="OnAppearanceClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◐" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <layout:TextRoom VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppearanceLabel, ElementName=Root}" />
                            </layout:TextRoom>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Fs.IconFont}" FontSize="8" Margin="6,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton"
                            DockPanel.Dock="Right"
                            Margin="0,0,6,0"
                            Padding="7,3,7,4"
                            Style="{StaticResource Fs.ChromeButton}"
                            Visibility="{Binding IsCustomizing, Converter={StaticResource Fs.BoolToVisibility}}"
                            ToolTip="{Binding Texts[Window.Settings], ElementName=Root}"
                            AutomationProperties.Name="{Binding Texts[Window.Settings], ElementName=Root}"
                            Click="OnSettingsClick">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource Fs.IconFont}" FontSize="12" Margin="0,1,0,0" VerticalAlignment="Center" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="AppIcon" Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <layout:TextRoom VerticalAlignment="Center">
                            <TextBlock Text="FolderSwitch"
                                       FontSize="12.8"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fs.OnBackgroundMuted}" />
                        </layout:TextRoom>
                    </StackPanel>
                </DockPanel>

                <local:TabBar DockPanel.Dock="Top" />

                <!-- Context line: only when called from File Explorer or a file dialog. -->
                <Border DockPanel.Dock="Bottom"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Fs.Border}"
                        Padding="16,6,16,7"
                        Visibility="{Binding ContextLine, Converter={StaticResource Fs.NullToCollapsed}}">
                    <TextBlock Text="{Binding ContextLine}"
                               FontSize="11.85"
                               Foreground="{DynamicResource Fs.OnBackgroundMuted}"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- The board; dotted in Customize mode. -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCustomizing}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Fs.BoardDots}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer x:Name="BoardScroller"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <local:BoardView DataContext="{Binding ActiveTab}" />
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- The menus and panels of Customize mode (one at a time, see Flyout). -->
            <Popup x:Name="FlyoutPopup" />
        </Grid>
    </AdornerDecorator>
</UserControl>
