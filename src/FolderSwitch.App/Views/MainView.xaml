<!--
    The whole content of the main window, bound to MainViewModel (spec 5.2), from top to bottom: the title bar, the tab
    bar and the board of the active tab (scrolling past the screen's work area). Hosted by MainWindow, and rendered
    off-screen by the snapshot mode.
    The title bar's (?) and ⚙ open the About and settings windows, drawn over everything on a dimmed backdrop (the
    dialog layer). The menus (a group's Add menu and palette, an item's menu...) open in the flyout declared here (see
    Flyout). The adorner layer at the top carries the insertion line of a drag and drop over the tab bar (the board's
    scroller has its own).
-->
<UserControl x:Class="FolderSwitch.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderSwitch.App.Views"
             xmlns:layout="clr-namespace:FolderSwitch.App.Views.Layout"
             x:Name="Root"
             FontFamily="Segoe UI"
             FontSize="13"
             Foreground="{DynamicResource Fs.OnBackgroundText}">
    <AdornerDecorator>
        <Grid>
            <DockPanel>
                <!--
                    Title bar: icon and name, then Ko-fi's button in Customize mode; on the right « Edit », ⚙ (the
                    settings), (?) (About) and ✕. Pressed anywhere but on a button, its margins included (the border's
                    transparent background, which covers them, takes the clicks), it moves the window (see
                    OnTitleBarMouseLeftButtonDown).
                -->
                <Border DockPanel.Dock="Top" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <DockPanel Margin="16,9,10,6">
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Style="{StaticResource Fs.CloseButton}"
                                Command="{Binding CloseCommand}"
                                ToolTip="{Binding Texts[Window.Close], ElementName=Root}"
                                AutomationProperties.Name="{Binding Texts[Window.Close], ElementName=Root}" />
                        <Button x:Name="AboutButton"
                                DockPanel.Dock="Right"
                                Margin="0"
                                Padding="7,3,7,4"
                                Style="{StaticResource Fs.ChromeButton}"
                                ToolTip="{Binding Texts[Settings.About], ElementName=Root}"
                                AutomationProperties.Name="{Binding Texts[Settings.About], ElementName=Root}"
                                Click="OnAboutClick">
                            <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource Fs.IconFont}" FontSize="12" Margin="0,1,0,0" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="SettingsButton"
                                DockPanel.Dock="Right"
                                Margin="0,0,6,0"
                                Padding="7,3,7,4"
                                Style="{StaticResource Fs.ChromeButton}"
                                ToolTip="{Binding Texts[Window.Settings], ElementName=Root}"
                                AutomationProperties.Name="{Binding Texts[Window.Settings], ElementName=Root}"
                                Click="OnSettingsClick">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource Fs.IconFont}" FontSize="12" Margin="0,1,0,0" VerticalAlignment="Center" />
                        </Button>
                        <Button DockPanel.Dock="Right" Margin="0,0,6,0" Style="{StaticResource Fs.CustomizeButton}" Command="{Binding ToggleCustomizeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Fs.IconFont}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE70F;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomizing}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <layout:TextRoom VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CustomizeLabel}" />
                                </layout:TextRoom>
                            </StackPanel>
                        </Button>
                        <layout:TitleRowPanel x:Name="TitleRow" VerticalAlignment="Center">
                            <Image x:Name="AppIcon" Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <layout:TextRoom VerticalAlignment="Center">
                                <!-- The name, then the version that runs, lighter. -->
                                <TextBlock FontSize="12.8" Foreground="{DynamicResource Fs.OnBackgroundMuted}">
                                    <Run Text="FolderSwitch" FontWeight="SemiBold" />
                                    <Run x:Name="VersionRun" FontSize="11.4" />
                                </TextBlock>
                            </layout:TextRoom>
                            <!--
                                Customize mode only: Ko-fi's button, which opens the author's Ko-fi page in the browser. Drawn
                                as Ko-fi's « Buy me a coffee » button (its yellow, its cup, dark bold text) but with the text
                                in the language shown, at the size of the name. As high as the other buttons; left out when
                                the title bar lacks room for it (see TitleRowPanel).
                            -->
                            <Button x:Name="SupportButton"
                                    Margin="28,0,0,0"
                                    VerticalAlignment="Center"
                                    Focusable="False"
                                    Cursor="Hand"
                                    ToolTip="{Binding Texts[Window.Support], ElementName=Root}"
                                    AutomationProperties.Name="{Binding Texts[Window.Support], ElementName=Root}"
                                    Click="OnSupportClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <!-- The cup's picture has the same yellow around it, so it melts into the background. -->
                                        <Border x:Name="Face" Height="26" Padding="7,0,10,0" CornerRadius="7" Background="#FFDA6E">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Height="15"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Source="/FolderSwitch;component/Assets/ko-fi-cup.png"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="12.8"
                                                           FontWeight="Bold"
                                                           Foreground="#202020"
                                                           Text="{Binding Texts[Window.SupportButton], ElementName=Root}" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Face" Property="Opacity" Value="0.85" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomizing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </layout:TitleRowPanel>
                    </DockPanel>
                </Border>

                <local:TabBar DockPanel.Dock="Top" />

                <!-- The board; dotted in Customize mode. -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCustomizing}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Fs.BoardDots}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer x:Name="BoardScroller"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <!-- Every tab's board, the active one shown: the window keeps the width of the widest. -->
                        <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <layout:TabBoardsPanel ActiveItem="{Binding ActiveTab}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource Fs.SameReference}">
                                                    <Binding />
                                                    <Binding Path="DataContext.ActiveTab" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:BoardView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- The settings and About windows, one at a time, over everything; a click on the backdrop closes them. -->
            <Border x:Name="DialogLayer"
                    Background="{StaticResource Fs.Scrim}"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="OnDialogLayerMouseDown">
                <Border x:Name="DialogFrame"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderThickness="1"
                        CornerRadius="12"
                        SnapsToDevicePixels="True"
                        Background="{DynamicResource Fs.Menu}"
                        BorderBrush="{DynamicResource Fs.Border}"
                        Effect="{DynamicResource Fs.FlyoutShadow}"
                        TextElement.Foreground="{DynamicResource Fs.MenuText}" />
            </Border>

            <!-- The menus of Customize mode (one at a time, see Flyout). -->
            <Popup x:Name="FlyoutPopup" />
        </Grid>
    </AdornerDecorator>
</UserControl>
