<!--
    The « Add ▾ » menu of a group (Customize mode), bound to an AddMenuViewModel. From top to bottom: what the calling
    window shows, « Current folder » or « Current URL » with its path or address in grey (greyed out and checked when the
    group holds it already), and a separator, only when there is one; « Folder… » (the Windows folder picker),
    « Special folders ▸ », « File… » (the Windows file picker) and « URL… » (the address prompt), the first and the last
    with a (?) whose tooltip tells how to get the first line; « Separator », which appends a line to the group at once
    (dragged into place afterwards); then, called from File Explorer, a file dialog or a
    browser, a grey line that says so, which does nothing. « Special folders ▸ » shows the special folders in place of
    the menu, personal then system (one the group holds already greyed out and checked), under « ◂ », which comes back.
    Shown in a Flyout under the button; a choice closes it.
-->
<UserControl x:Class="FolderSwitch.App.Views.AddMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FolderSwitch.Presentation.ViewModels;assembly=FolderSwitch.Presentation"
             x:Name="Root"
             Width="300">
    <UserControl.Resources>
        <!-- The icon at the start of a line, on the 24 × 24 grid. -->
        <Style x:Key="LineIcon" TargetType="Viewbox">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The grey text at the end of a line. -->
        <Style x:Key="LineHint" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Fs.MenuMuted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- A (?) over the end of a line: its tooltip, the text of its Tag, is a tip. It is no part of the line's button,
             so that a click on it does not choose the line. -->
        <Style x:Key="Tip" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>

        <DataTemplate x:Key="EntryTemplate">
            <Button Style="{StaticResource Fs.MenuItemButton}"
                    IsEnabled="{Binding AlreadyPresent, Converter={StaticResource Fs.Not}}"
                    ToolTip="{Binding ToolTip}"
                    ToolTipService.ShowOnDisabled="True"
                    Click="OnSpecialClick">
                <DockPanel>
                    <Viewbox Style="{StaticResource LineIcon}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Fs.FolderGeometry}" Fill="{DynamicResource Fs.Accent}" />
                        </Canvas>
                    </Viewbox>
                    <!-- Already in the group: checked at the end of the line. -->
                    <TextBlock DockPanel.Dock="Right"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="✓"
                               Visibility="{Binding AlreadyPresent, Converter={StaticResource Fs.BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource LineHint}" MaxWidth="118" Text="{Binding StorageForm}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <StackPanel x:Name="MainPage">
            <!-- What the calling window shows: only once known. -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentKind}" Value="{x:Static vm:AddMenuCurrent.None}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button x:Name="CurrentEntry"
                        IsEnabled="{Binding CurrentAlreadyPresent, Converter={StaticResource Fs.Not}}"
                        ToolTipService.ShowOnDisabled="True"
                        Click="OnCurrentClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Fs.MenuItemButton}">
                            <Setter Property="ToolTip" Value="{Binding CurrentDetail}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentAlreadyPresent}" Value="True">
                                    <Setter Property="ToolTip" Value="{Binding Texts[Item.AlreadyPresent], ElementName=Root}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <DockPanel>
                        <Viewbox Style="{StaticResource LineIcon}">
                            <Canvas Width="24" Height="24">
                                <Path>
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource Fs.OutlineIcon}">
                                            <Setter Property="Data" Value="{StaticResource Fs.FolderGeometry}" />
                                            <Setter Property="Fill" Value="{DynamicResource Fs.Accent}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentKind}" Value="{x:Static vm:AddMenuCurrent.Url}">
                                                    <Setter Property="Data" Value="{StaticResource Fs.GlobeGeometry}" />
                                                    <Setter Property="Fill" Value="{x:Null}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource Fs.Accent}" />
                                                    <Setter Property="StrokeThickness" Value="1.6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="✓"
                                   Visibility="{Binding CurrentAlreadyPresent, Converter={StaticResource Fs.BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource LineHint}" MaxWidth="160" Text="{Binding CurrentDetail}" />
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Texts[AddMenu.CurrentFolder], ElementName=Root}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentKind}" Value="{x:Static vm:AddMenuCurrent.Url}">
                                            <Setter Property="Text" Value="{Binding Texts[AddMenu.CurrentUrl], ElementName=Root}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Button>
                <Border Height="1" Margin="4,5,4,5" Background="{DynamicResource Fs.Border}" />
            </StackPanel>

            <Grid>
                <Button Style="{StaticResource Fs.MenuItemButton}" Click="OnFolderClick">
                    <DockPanel>
                        <Viewbox Style="{StaticResource LineIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Fs.FolderGeometry}" Fill="{DynamicResource Fs.Accent}" />
                            </Canvas>
                        </Viewbox>
                        <!-- The room of the (?). -->
                        <Border DockPanel.Dock="Right" Width="18" />
                        <TextBlock Style="{StaticResource LineHint}" Text="{Binding Texts[Item.BrowseHint], ElementName=Root}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Texts[AddMenu.Folder], ElementName=Root}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
                <Border x:Name="FolderTip" Style="{StaticResource Tip}" Tag="{Binding Texts[AddMenu.FolderTip], ElementName=Root}">
                    <Border.ToolTip>
                        <TextBlock MaxWidth="300" TextWrapping="Wrap" Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}" />
                    </Border.ToolTip>
                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource Fs.OutlineIcon}" Data="{StaticResource Fs.HelpGeometry}" Stroke="{DynamicResource Fs.MenuMuted}" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </Grid>

            <Button Style="{StaticResource Fs.MenuItemButton}" Click="OnSpecialFoldersClick">
                <DockPanel>
                    <Viewbox Style="{StaticResource LineIcon}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Fs.FolderGeometry}" Fill="{DynamicResource Fs.Accent}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock DockPanel.Dock="Right" Margin="12,1,4,0" VerticalAlignment="Center" FontFamily="{StaticResource Fs.IconFont}" FontSize="10" Foreground="{DynamicResource Fs.MenuMuted}" Text="&#xE76C;" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Texts[AddMenu.SpecialFolders], ElementName=Root}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>

            <Button Style="{StaticResource Fs.MenuItemButton}" Click="OnFileClick">
                <DockPanel>
                    <Viewbox Style="{StaticResource LineIcon}">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource Fs.OutlineIcon}" Data="{StaticResource Fs.FileGeometry}" Stroke="{DynamicResource Fs.Accent}" StrokeThickness="1.7" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center" Text="{Binding Texts[AddMenu.File], ElementName=Root}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>

            <Grid>
                <Button Style="{StaticResource Fs.MenuItemButton}" Click="OnUrlClick">
                    <DockPanel>
                        <Viewbox Style="{StaticResource LineIcon}">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource Fs.OutlineIcon}" Data="{StaticResource Fs.GlobeGeometry}" Stroke="{DynamicResource Fs.Accent}" StrokeThickness="1.6" />
                            </Canvas>
                        </Viewbox>
                        <Border DockPanel.Dock="Right" Width="18" />
                        <TextBlock Style="{StaticResource LineHint}" Text="{Binding Texts[AddMenu.UrlHint], ElementName=Root}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Texts[AddMenu.Url], ElementName=Root}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
                <Border x:Name="UrlTip" Style="{StaticResource Tip}" Tag="{Binding Texts[AddMenu.UrlTip], ElementName=Root}">
                    <Border.ToolTip>
                        <TextBlock MaxWidth="300" TextWrapping="Wrap" Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}" />
                    </Border.ToolTip>
                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource Fs.OutlineIcon}" Data="{StaticResource Fs.HelpGeometry}" Stroke="{DynamicResource Fs.MenuMuted}" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </Grid>

            <!-- A separator, added at the end of the group (several are allowed: never greyed out). -->
            <Button Style="{StaticResource Fs.MenuItemButton}" Click="OnSeparatorClick">
                <DockPanel>
                    <Viewbox Style="{StaticResource LineIcon}">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,12 H21" Stroke="{DynamicResource Fs.Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center" Text="{Binding Texts[AddMenu.Separator], ElementName=Root}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>

            <!-- Where FolderSwitch was called from: a line that does nothing. -->
            <StackPanel Visibility="{Binding Footer, Converter={StaticResource Fs.NullToCollapsed}}">
                <Border Height="1" Margin="4,5,4,1" Background="{DynamicResource Fs.Border}" />
                <DockPanel Margin="7,5,7,3">
                    <TextBlock DockPanel.Dock="Left"
                               Width="16"
                               Margin="0,1,9,0"
                               VerticalAlignment="Top"
                               FontFamily="{StaticResource Fs.IconFont}"
                               FontSize="12"
                               Foreground="{DynamicResource Fs.MenuMuted}"
                               Text="&#xE946;" />
                    <TextBlock FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Fs.MenuMuted}"
                               Text="{Binding Footer}" />
                </DockPanel>
            </StackPanel>
        </StackPanel>

        <!-- « Special folders ▸ »: in place of the menu. -->
        <StackPanel x:Name="SpecialPage" Visibility="Collapsed">
            <Button Style="{StaticResource Fs.MenuItemButton}" Click="OnBackClick">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Width="16" Margin="0,1,9,0" VerticalAlignment="Center" TextAlignment="Center" FontFamily="{StaticResource Fs.IconFont}" FontSize="10" Foreground="{DynamicResource Fs.MenuMuted}" Text="&#xE76B;" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Texts[AddMenu.SpecialFolders], ElementName=Root}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>

            <Border Height="1" Margin="4,5,4,1" Background="{DynamicResource Fs.Border}" />

            <ScrollViewer MaxHeight="350"
                          Template="{StaticResource Fs.ThinScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel>
                    <TextBlock Style="{StaticResource Fs.MenuLabel}"
                               Text="{Binding Texts[Item.SpecialPersonal], ElementName=Root, Converter={StaticResource Fs.UpperCase}}" />
                    <ItemsControl ItemsSource="{Binding PersonalFolders, ElementName=Root}" ItemTemplate="{StaticResource EntryTemplate}" Focusable="False" />
                    <TextBlock Style="{StaticResource Fs.MenuLabel}"
                               Text="{Binding Texts[Item.SpecialSystem], ElementName=Root, Converter={StaticResource Fs.UpperCase}}" />
                    <ItemsControl ItemsSource="{Binding SystemFolders, ElementName=Root}" ItemTemplate="{StaticResource EntryTemplate}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
