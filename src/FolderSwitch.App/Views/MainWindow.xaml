<!--
    The resident main window: built once at startup, shown and hidden, never closed (closing hides it). Borderless, no
    system title bar: its content is MainView. The window follows the size of its content, within the work area of its
    screen (WindowController places it and sets the bounds); the Desktop Window Manager rounds its corners on Windows 11
    and gives it a shadow, while Windows 10 gets a 1 px border instead (see the code-behind).
    Keyboard: Tab / Shift+Tab change tab and never move the focus, Escape hides (spec 5.3); in Customize mode F2
    renames the selection (spec 5.4), and Escape first closes an open menu, the settings or About window, or cancels a
    rename.
-->
<Window x:Class="FolderSwitch.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderSwitch.App.Views"
        Title="FolderSwitch"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        MinWidth="360"
        Background="{DynamicResource Fs.Background}"
        BorderBrush="{DynamicResource Fs.WindowBorder}"
        BorderThickness="0"
        UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="None"
        KeyboardNavigation.ControlTabNavigation="None"
        KeyboardNavigation.DirectionalNavigation="None"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
        <KeyBinding Key="F2" Command="{Binding RenameSelectedCommand}" />
    </Window.InputBindings>

    <local:MainView x:Name="View" />
</Window>
