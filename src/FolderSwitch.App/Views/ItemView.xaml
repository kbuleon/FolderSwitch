<!--
    An item of a group, bound to an ItemViewModel: its icon, the name, then the path (the host, for a site) in grey, both
    ellipsized when the column is too narrow (the full path is in the tooltip). The icon is a folder in the group's color,
    the icon Windows gives the type of a file, the site's own icon, or the drawn file outline or globe until that one is
    known and when there is none. Click or Ctrl+click opens it. An item the calling window cannot use (a file or a site,
    from a file dialog) is faded, and its tooltip says why.
    A separator is a thin line across the row instead, in the group's muted text color, never faded: 1 DIP with 3 DIPs
    of room above and below (7 DIPs in all) in normal use, where it does nothing (no highlight, no menu, no tooltip);
    16 DIPs in Customize mode, so that it is easy to grab, to right-click and to remove.
    Customize mode: a click selects it (F2 renames it), a double-click on it renames it in place, a drag moves it
    within its group or to another group of the tab, and ✕ shows under the mouse to remove it.
-->
<UserControl x:Class="FolderSwitch.App.Views.ItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderSwitch.App.Views"
             xmlns:layout="clr-namespace:FolderSwitch.App.Views.Layout"
             x:Name="Root">
    <ContentControl x:Name="Row" ToolTipService.InitialShowDelay="700">
        <ContentControl.Style>
            <Style TargetType="ContentControl" BasedOn="{StaticResource Fs.ItemRow}">
                <Setter Property="ToolTip" Value="{Binding SecondaryText}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUsable}" Value="False">
                        <Setter Property="ToolTip" Value="{Binding Texts[Item.FoldersOnly], RelativeSource={RelativeSource AncestorType=local:MainView}}" />
                        <Setter Property="Opacity" Value="0.4" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </DataTrigger>
                    <!-- A separator (after the trigger above, which it overrides): never faded, no tooltip, a short row. -->
                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                        <Setter Property="ToolTip" Value="{x:Null}" />
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Padding" Value="8,3,8,3" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <layout:ItemRowPanel Spacing="8" Visibility="{Binding IsSeparator, Converter={StaticResource Fs.InverseBoolToVisibility}}">
                <Grid Width="16" Height="16">
                    <Viewbox Visibility="{Binding HasPicture, ElementName=Picture, Converter={StaticResource Fs.InverseBoolToVisibility}}">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource Fs.ItemIcon}" />
                        </Canvas>
                    </Viewbox>
                    <local:ItemIcon x:Name="Picture" Extension="{Binding Extension}" FaviconPath="{Binding FaviconPath}" />
                </Grid>
                <Grid>
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="{DynamicResource Fs.ItemFontSize}"
                               Foreground="{DynamicResource Fs.Group.ItemText}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsRenaming, Converter={StaticResource Fs.InverseBoolToVisibility}}" />
                    <TextBox Style="{StaticResource Fs.RenameBox}"
                             Margin="-4,-3,0,-3"
                             FontSize="{DynamicResource Fs.ItemFontSize}"
                             local:InlineRename.IsActive="{Binding IsRenaming, Mode=OneWay}"
                             Visibility="{Binding IsRenaming, Converter={StaticResource Fs.BoolToVisibility}}" />
                </Grid>
                <TextBlock Text="{Binding SecondaryText}"
                           FontSize="11.5"
                           Foreground="{DynamicResource Fs.Group.ItemMuted}"
                           TextTrimming="CharacterEllipsis" />
            </layout:ItemRowPanel>

            <!-- A separator: the line, across the row, with 10 DIPs of room in Customize mode (the hit area). Shown to
                 accessibility tools as a separator. -->
            <Grid Visibility="{Binding IsSeparator, Converter={StaticResource Fs.BoolToVisibility}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsCustomizing, RelativeSource={RelativeSource AncestorType=local:MainView}}" Value="True">
                                <Setter Property="MinHeight" Value="10" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Separator Height="1"
                           Margin="0"
                           VerticalAlignment="Center"
                           Focusable="False"
                           Background="{DynamicResource Fs.Group.ItemMuted}"
                           Opacity="0.5"
                           SnapsToDevicePixels="True"
                           AutomationProperties.Name="{Binding Texts[Item.Separator], RelativeSource={RelativeSource AncestorType=local:MainView}}">
                    <Separator.Template>
                        <ControlTemplate TargetType="Separator">
                            <Border Background="{TemplateBinding Background}" />
                        </ControlTemplate>
                    </Separator.Template>
                </Separator>
            </Grid>

            <!-- Customize mode: ✕, shown under the mouse (its room is kept, so that nothing moves). -->
            <Button Grid.Column="1"
                    Foreground="{DynamicResource Fs.Group.ItemMuted}"
                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=local:MainView}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Fs.RemoveButton}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Margin" Value="6,-2,-4,-2" />
                        <Setter Property="ToolTip" Value="{Binding Texts[Item.Remove], RelativeSource={RelativeSource AncestorType=local:MainView}}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Texts[Item.Remove], RelativeSource={RelativeSource AncestorType=local:MainView}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsCustomizing, RelativeSource={RelativeSource AncestorType=local:MainView}}" Value="True">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.IsCustomizing, RelativeSource={RelativeSource AncestorType=local:MainView}}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <!-- A separator's row is 10 DIPs high inside: the ✕ overflows it a little more. -->
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter Property="Margin" Value="6,-4,-4,-4" />
                                <Setter Property="ToolTip" Value="{Binding Texts[Item.RemoveSeparator], RelativeSource={RelativeSource AncestorType=local:MainView}}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Texts[Item.RemoveSeparator], RelativeSource={RelativeSource AncestorType=local:MainView}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </ContentControl>
</UserControl>
