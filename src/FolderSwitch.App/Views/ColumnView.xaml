<!--
    A column of the board, bound to a ColumnViewModel: its groups stacked, all at the column's effective width (fixed,
    or fitted to the content).
    Customize mode: outlined with dashes, « + Group » at the bottom, ✕ on its corner while it is empty, the resize grip
    on its right edge (with the width shown above the column while it is dragged), and it takes the groups dropped on
    it (an insertion line shows where).
-->
<UserControl x:Class="FolderSwitch.App.Views.ColumnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderSwitch.App.Views"
             xmlns:layout="clr-namespace:FolderSwitch.App.Views.Layout"
             x:Name="Root"
             AllowDrop="{Binding IsCustomizing, ElementName=Root}"
             DragEnter="OnDragOver"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave"
             Drop="OnDrop">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <!-- An empty column stays a visible place to drop a group on. -->
                <DataTrigger Binding="{Binding IsCustomizing, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="MinHeight" Value="150" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <!-- Transparent: a group dragged over the column's empty part still lands on it. -->
    <Grid Background="Transparent">
        <Rectangle Margin="-2"
                   RadiusX="10"
                   RadiusY="10"
                   StrokeThickness="1.5"
                   StrokeDashArray="3 2"
                   Stroke="{DynamicResource Fs.ColumnOutline}"
                   IsHitTestVisible="False"
                   Visibility="{Binding IsCustomizing, ElementName=Root, Converter={StaticResource Fs.BoolToVisibility}}" />
        <layout:ColumnWidthPresenter x:Name="WidthPresenter" Margin="4" FixedWidth="{Binding Width}">
            <StackPanel>
                <ItemsControl x:Name="GroupsList" ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <layout:SpacingPanel Spacing="{DynamicResource Fs.GroupGap}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:GroupView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource Fs.AddGroupButton}"
                        Margin="0,10,0,0"
                        Command="{Binding DataContext.AddGroupCommand, RelativeSource={RelativeSource AncestorType=local:MainView}}"
                        CommandParameter="{Binding}"
                        Visibility="{Binding IsCustomizing, ElementName=Root, Converter={StaticResource Fs.BoolToVisibility}}">
                    <TextBlock Text="{Binding Texts[Board.AddGroup], RelativeSource={RelativeSource AncestorType=local:MainView}}"
                               TextTrimming="CharacterEllipsis" />
                </Button>
            </StackPanel>
        </layout:ColumnWidthPresenter>

        <!-- ✕ of an empty column, on its corner. -->
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-10,-10,0"
                Command="{Binding DataContext.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=local:MainView}}"
                CommandParameter="{Binding}"
                ToolTip="{Binding Texts[Column.Remove], RelativeSource={RelativeSource AncestorType=local:MainView}}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Fs.RemoveButton}">
                    <Setter Property="Background" Value="{DynamicResource Fs.Menu}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Fs.Border}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="{DynamicResource Fs.MenuMuted}" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEmpty}" Value="True" />
                                <Condition Binding="{Binding IsCustomizing, ElementName=Root}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- The resize grip, in the gap after the column. -->
        <local:ColumnResizeGrip x:Name="Grip"
                                HorizontalAlignment="Right"
                                Margin="0,0,-12,0"
                                ToolTip="{Binding Texts[Column.ResizeHint], RelativeSource={RelativeSource AncestorType=local:MainView}}"
                                ToolTipService.InitialShowDelay="900"
                                Visibility="{Binding IsCustomizing, ElementName=Root, Converter={StaticResource Fs.BoolToVisibility}}" />

        <!-- The width while the grip is dragged. -->
        <Border x:Name="WidthLabel"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,-10,0,0"
                Padding="7,1,7,2"
                CornerRadius="5"
                Background="{DynamicResource Fs.Accent}"
                IsHitTestVisible="False"
                Visibility="{Binding PreviewWidth, ElementName=WidthPresenter, Converter={StaticResource Fs.NullToCollapsed}}">
            <TextBlock FontSize="11.2" FontWeight="SemiBold" Foreground="{DynamicResource Fs.OnAccent}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource Fs.Format}">
                        <Binding Path="Texts[Column.Width]" RelativeSource="{RelativeSource AncestorType=local:MainView}" />
                        <Binding Path="PreviewWidth" ElementName="WidthPresenter" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
