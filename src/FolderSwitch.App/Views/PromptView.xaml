<!--
    The content of FolderSwitch's own message boxes (PromptWindow): an icon, the message and the buttons, on the menu
    surface of the theme. A question has « Yes » and « No » (« No » is the default: Enter and Escape both answer it,
    as the message boxes did); an error or a notice has « OK ». Also drawn by the snapshots.
-->
<UserControl x:Class="FolderSwitch.App.Views.PromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             FontFamily="Segoe UI"
             FontSize="13"
             Foreground="{DynamicResource Fs.MenuText}"
             MinWidth="300"
             MaxWidth="440">
    <Grid Margin="20,18,18,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Width="30"
                Height="30"
                Margin="0,0,14,0"
                VerticalAlignment="Top"
                CornerRadius="15"
                Background="{Binding IconBackground, ElementName=Root}">
            <TextBlock Text="{Binding Glyph, ElementName=Root}"
                       FontFamily="{StaticResource Fs.IconFont}"
                       FontSize="15"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{Binding IconForeground, ElementName=Root}" />
        </Border>

        <TextBlock Grid.Column="1"
                   Margin="0,5,0,0"
                   TextWrapping="Wrap"
                   LineHeight="19"
                   Text="{Binding Message, ElementName=Root}" />

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="YesButton"
                    Style="{StaticResource Fs.PanelButton}"
                    MinWidth="84"
                    Margin="0,0,8,0"
                    Focusable="True"
                    Click="OnYesClick">
                <TextBlock Text="{Binding YesText, ElementName=Root}" />
            </Button>
            <Button x:Name="NoButton"
                    Style="{StaticResource Fs.PrimaryButton}"
                    MinWidth="84"
                    Focusable="True"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnNoClick">
                <TextBlock Text="{Binding NoText, ElementName=Root}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
