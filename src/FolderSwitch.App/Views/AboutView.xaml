<!--
    The About window, opened by the (?) button of the title bar and shown by MainView over the whole window on a dimmed
    backdrop, like the settings: the icon, the name, the version and what FolderSwitch does, with ✕ to close it.
    Under a rule, the legal notices of GPLv3 section 0: the copyright, the license and the absence of warranty, with links
    to the license and the third-party notices installed next to the executable. The copyright line and the license's
    name are not translated.
-->
<UserControl x:Class="FolderSwitch.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="340">
    <Grid>
        <Button Margin="0,10,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Style="{StaticResource Fs.DialogCloseButton}"
                Click="OnCloseClick"
                ToolTip="{Binding Texts[Window.Close], ElementName=Root}"
                AutomationProperties.Name="{Binding Texts[Window.Close], ElementName=Root}" />
        <StackPanel Margin="28,30,28,28">
            <Image x:Name="Icon" Width="56" Height="56" HorizontalAlignment="Center" />
            <TextBlock Margin="0,14,0,0"
                       HorizontalAlignment="Center"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Text="FolderSwitch" />
            <TextBlock Margin="0,3,0,0"
                       HorizontalAlignment="Center"
                       FontSize="12.2"
                       Foreground="{DynamicResource Fs.MenuMuted}"
                       Text="{Binding VersionText, ElementName=Root}" />
            <TextBlock Margin="0,16,0,0"
                       FontSize="12.8"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding Texts[About.Description], ElementName=Root}" />
            <Border Margin="0,18,0,12" Height="1" Background="{DynamicResource Fs.Border}" />
            <TextBlock FontSize="11.5"
                       Foreground="{DynamicResource Fs.MenuMuted}"
                       TextAlignment="Center"
                       TextWrapping="Wrap">
                <Run Text="Copyright (C) 2026 Karl BULEON" />
                <LineBreak />
                <Run Text="GPL-3.0-or-later ·" />
                <Run Text="{Binding Texts[About.NoWarranty], ElementName=Root, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,8,0,0" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap">
                <Hyperlink Foreground="{DynamicResource Fs.Accent}" Click="OnLicenseClick">
                    <Run Text="{Binding Texts[About.License], ElementName=Root, Mode=OneWay}" />
                </Hyperlink>
                <Run Text=" · " Foreground="{DynamicResource Fs.MenuMuted}" />
                <Hyperlink Foreground="{DynamicResource Fs.Accent}" Click="OnNoticesClick">
                    <Run Text="{Binding Texts[About.ThirdPartyNotices], ElementName=Root, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
