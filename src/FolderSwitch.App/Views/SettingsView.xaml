<!--
    The settings window (spec 5.4), bound to SettingsViewModel, shown by MainView over the whole window on a dimmed
    backdrop: its title and ✕ at the top, the categories on the left, the page of the chosen one on the right. General:
    the language (native names), starting with Windows, the update check (greyed out without one) and the version.
    Shortcut: the editor, then « Apply », greyed out while the combination shown is the one in effect, which a green note
    says. Appearance: the appearance menu (AppearanceMenu). Configuration: export and import. Every change takes effect
    at once; the pages keep one size, so that changing category does not resize the window, and scroll when the screen
    is too short for them.
-->
<UserControl x:Class="FolderSwitch.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderSwitch.App.Views"
             x:Name="Root">
    <DockPanel>
        <!-- Title and ✕ -->
        <DockPanel DockPanel.Dock="Top" Margin="18,11,10,10">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource Fs.DialogCloseButton}"
                    Click="OnCloseClick"
                    ToolTip="{Binding Texts[Window.Close], ElementName=Root}"
                    AutomationProperties.Name="{Binding Texts[Window.Close], ElementName=Root}" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Texts[Window.Settings], ElementName=Root}" />
        </DockPanel>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Fs.Border}" />

        <!-- Categories -->
        <Border DockPanel.Dock="Left"
                MinWidth="168"
                Padding="8,10,8,10"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource Fs.Border}">
            <ItemsControl ItemsSource="{Binding Pages, ElementName=Root}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Fs.NavButton}"
                                Margin="0,0,0,2"
                                Click="OnPageClick"
                                local:Selection.IsSelected="{Binding IsSelected}"
                                AutomationProperties.Name="{Binding Label}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="16"
                                           Margin="0,1,9,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Fs.IconFont}"
                                           FontSize="13"
                                           Text="{Binding Glyph}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- The page of the chosen category -->
        <ScrollViewer Width="376"
                      MaxHeight="472"
                      Focusable="False"
                      Template="{StaticResource Fs.ThinScrollViewer}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <!-- The ScrollViewer's whole height (472) when the window has room: the same size for every page. -->
            <Grid Margin="18,10,18,16" MinHeight="446">
                <!-- General -->
                <StackPanel x:Name="GeneralPage">
                    <TextBlock Style="{StaticResource Fs.MenuLabel}" Margin="0,6,0,5" Text="{Binding Texts[Settings.Language], ElementName=Root, Converter={StaticResource Fs.UpperCase}}" />
                    <ComboBox Style="{StaticResource Fs.ComboBox}"
                              ItemsSource="{Binding Languages}"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding Language, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Texts[Settings.Language], ElementName=Root}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NativeName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox Style="{StaticResource Fs.CheckBox}" Margin="0,16,0,0" IsChecked="{Binding StartWithWindows, Mode=TwoWay}">
                        <TextBlock Text="{Binding Texts[Settings.StartWithWindows], ElementName=Root}" TextWrapping="Wrap" />
                    </CheckBox>

                    <TextBlock Style="{StaticResource Fs.MenuLabel}" Margin="0,20,0,5" Text="{Binding Texts[Settings.UpdatesSection], ElementName=Root, Converter={StaticResource Fs.UpperCase}}" />
                    <TextBlock Margin="0,0,0,8" FontSize="12.2" Foreground="{DynamicResource Fs.MenuMuted}">
                        <Run Text="FolderSwitch" FontWeight="SemiBold" Foreground="{DynamicResource Fs.MenuText}" />
                        <Run Text="·" />
                        <Run Text="{Binding VersionText, ElementName=Root, Mode=OneWay}" />
                    </TextBlock>
                    <Button Style="{StaticResource Fs.PanelButton}" HorizontalAlignment="Left" Command="{Binding CheckUpdatesCommand}">
                        <TextBlock Text="{Binding Texts[Settings.Updates], ElementName=Root}" TextTrimming="CharacterEllipsis" />
                    </Button>
                </StackPanel>

                <!-- Shortcut -->
                <StackPanel x:Name="HotkeyPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Fs.MenuLabel}" Margin="0,6,0,5" Text="{Binding Texts[Settings.Hotkey], ElementName=Root, Converter={StaticResource Fs.UpperCase}}" />
                    <local:HotkeyEditor x:Name="Editor"
                                        DataContext="{Binding Hotkey}"
                                        Texts="{Binding Texts, ElementName=Root}"
                                        Note="{Binding AppliedNote, ElementName=Root}" />
                    <Button Style="{StaticResource Fs.PrimaryButton}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding ApplyHotkeyCommand}">
                        <TextBlock Text="{Binding Texts[Hotkey.Apply], ElementName=Root}" />
                    </Button>
                </StackPanel>

                <!-- Appearance: the appearance menu, put here when the page is first shown -->
                <ContentControl x:Name="AppearancePage" Focusable="False" HorizontalAlignment="Left" Visibility="Collapsed" />

                <!-- Configuration -->
                <StackPanel x:Name="ConfigurationPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Fs.MenuLabel}" Margin="0,6,0,5" Text="{Binding Texts[Settings.Configuration], ElementName=Root, Converter={StaticResource Fs.UpperCase}}" />
                    <TextBlock Margin="0,0,0,12"
                               FontSize="12.2"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Fs.MenuMuted}"
                               Text="{Binding Texts[Settings.ConfigurationNote], ElementName=Root}" />
                    <Button Style="{StaticResource Fs.PanelButton}" Command="{Binding ExportCommand}">
                        <TextBlock Text="{Binding Texts[Settings.Export], ElementName=Root}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Button Style="{StaticResource Fs.PanelButton}" Margin="0,6,0,0" Command="{Binding ImportCommand}">
                        <TextBlock Text="{Binding Texts[Settings.Import], ElementName=Root}" TextTrimming="CharacterEllipsis" />
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
