<!--
    The « + Folder ▾ » menu of a group (Customize mode, spec 5.4): « Browse… » (the Windows folder picker), then the
    special folders, personal then system, from GroupViewModel.SpecialFolderStates; one the group already holds is
    greyed out and checked. Shown in a Flyout under the button; a choice closes it.
-->
<UserControl x:Class="FolderSwitch.App.Views.AddFolderMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="292">
    <UserControl.Resources>
        <DataTemplate x:Key="EntryTemplate">
            <Button Style="{StaticResource Fs.MenuItemButton}"
                    IsEnabled="{Binding AlreadyPresent, Converter={StaticResource Fs.Not}}"
                    ToolTip="{Binding ToolTip}"
                    ToolTipService.ShowOnDisabled="True"
                    Click="OnSpecialClick">
                <DockPanel>
                    <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Fs.FolderGeometry}" Fill="{DynamicResource Fs.Accent}" />
                        </Canvas>
                    </Viewbox>
                    <!-- Already in the group: checked at the end of the line, as in the mockup. -->
                    <TextBlock DockPanel.Dock="Right"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="✓"
                               Visibility="{Binding AlreadyPresent, Converter={StaticResource Fs.BoolToVisibility}}" />
                    <TextBlock DockPanel.Dock="Right"
                               Margin="12,0,0,0"
                               MaxWidth="118"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Fs.MenuMuted}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding StorageForm}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Button Style="{StaticResource Fs.MenuItemButton}" Click="OnBrowseClick">
            <DockPanel>
                <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource Fs.FolderGeometry}" Fill="{DynamicResource Fs.Accent}" />
                    </Canvas>
                </Viewbox>
                <TextBlock DockPanel.Dock="Right"
                           Margin="12,0,0,0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Fs.MenuMuted}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Texts[Item.BrowseHint], ElementName=Root}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Texts[Item.Browse], ElementName=Root}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Button>

        <Border Height="1" Margin="4,5,4,1" Background="{DynamicResource Fs.Border}" />

        <ScrollViewer MaxHeight="350"
                      Template="{StaticResource Fs.ThinScrollViewer}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel>
                <TextBlock Style="{StaticResource Fs.MenuLabel}"
                           Text="{Binding Texts[Item.SpecialPersonal], ElementName=Root, Converter={StaticResource Fs.UpperCase}}" />
                <ItemsControl ItemsSource="{Binding PersonalFolders, ElementName=Root}" ItemTemplate="{StaticResource EntryTemplate}" Focusable="False" />
                <TextBlock Style="{StaticResource Fs.MenuLabel}"
                           Text="{Binding Texts[Item.SpecialSystem], ElementName=Root, Converter={StaticResource Fs.UpperCase}}" />
                <ItemsControl ItemsSource="{Binding SystemFolders, ElementName=Root}" ItemTemplate="{StaticResource EntryTemplate}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>
