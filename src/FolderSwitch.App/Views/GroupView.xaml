<!--
    A group block, bound to a GroupViewModel: its header (chevron, icon, name, item count while collapsed) and its
    items. The icon shows before the name, in the title's color, size and effect; without one, nothing takes its place.
    How it is drawn (colors, edges, frame, shadow) depends on the theme's group style and on the group's color: the
    code-behind puts those values in the block's own resources (Fs.Group.*, see GroupStyleSelector), read here with
    DynamicResource only. A click on the header collapses or expands the group.
    Customize mode adds, in the header: the grip ⠿ the group is dragged by, in the icon's place a button that shows the
    icon, or a discreet dashed square when there is none, the color dot that opens the palette and ✕;
    under the items, the whole width: « Add ▾ », which opens the Add menu (AddMenu). A double-click on the name renames
    it in place. The header is no button: its clicks, the grip's drag and the name's double-click are told apart by the
    code-behind, and the icon, the dot and ✕ are buttons of their own inside it.
    Layers, back to front: the shadow (cast by a plain shape, so that the effect never touches the text), the ring of
    the selection, then, clipped to the rounded corners, the body, the frame and the colored edges.
-->
<UserControl x:Class="FolderSwitch.App.Views.GroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderSwitch.App.Views"
             xmlns:layout="clr-namespace:FolderSwitch.App.Views.Layout"
             x:Name="Root"
             AllowDrop="{Binding IsCustomizing, ElementName=Root}"
             DragEnter="OnDragOver"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave"
             Drop="OnDrop">
    <Grid>
        <Border CornerRadius="{DynamicResource Fs.GroupRadius}"
                Background="{DynamicResource Fs.Group.ShadowFill}"
                Effect="{DynamicResource Fs.Group.Shadow}"
                IsHitTestVisible="False" />

        <!-- The selection of Customize mode (F2 renames it). -->
        <Border Margin="-3"
                CornerRadius="{DynamicResource Fs.Group.RingRadius}"
                BorderThickness="2"
                BorderBrush="{DynamicResource Fs.Accent}"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource Fs.SameReference}">
                                    <Binding />
                                    <Binding Path="DataContext.Selected" RelativeSource="{RelativeSource AncestorType=local:MainView}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <layout:RoundedClip CornerRadius="{DynamicResource Fs.GroupRadius}">
            <Grid Background="{DynamicResource Fs.Group.Body}">
                <DockPanel Margin="{DynamicResource Fs.Group.ContentInset}">
                    <Border x:Name="Header"
                            DockPanel.Dock="Top"
                            Cursor="Hand"
                            Background="{DynamicResource Fs.Group.HeaderBackground}"
                            BorderBrush="{DynamicResource Fs.Group.Accent}"
                            BorderThickness="{DynamicResource Fs.Group.HeaderUnderline}"
                            Padding="{DynamicResource Fs.Group.HeaderPadding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Customize mode: the grip a group is dragged by. -->
                            <Border x:Name="Grip"
                                    Grid.Column="0"
                                    Margin="-4,-4,4,-4"
                                    Padding="2,4,2,4"
                                    Background="Transparent"
                                    Cursor="SizeAll"
                                    Visibility="{Binding CustomizeVisibility, ElementName=Root}">
                                <TextBlock Text="⠿"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Fs.Group.HeaderGlyph}" />
                            </Border>

                            <Path Grid.Column="1"
                                  Data="{StaticResource Fs.ChevronGeometry}"
                                  Fill="{DynamicResource Fs.Group.HeaderGlyph}"
                                  Width="6"
                                  Height="8"
                                  Margin="1,0,8,0"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="{Binding ChevronAngle, ElementName=Root}" />
                                </Path.RenderTransform>
                            </Path>

                            <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                <!-- The icon, in the title's color, size and effect: in normal use only when there is one. -->
                                <TextBlock DockPanel.Dock="Left"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Fs.EmojiFont}"
                                           FontWeight="Normal"
                                           FontSize="{DynamicResource Fs.Group.TitleFontSize}"
                                           Foreground="{DynamicResource Fs.Group.HeaderText}"
                                           Effect="{DynamicResource Fs.Group.TitleEffect}"
                                           Text="{Binding Icon}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasIcon}" Value="True" />
                                                        <Condition Binding="{Binding IsCustomizing, ElementName=Root}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Customize mode: the icon, or an empty square, as a button of its own (like the color
                                     dot, its press never reaches the header: no collapse, no selection, no drag). -->
                                <Button x:Name="IconButton"
                                        DockPanel.Dock="Left"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource Fs.IconButton}"
                                        Content="{Binding Icon}"
                                        FontSize="{DynamicResource Fs.Group.TitleFontSize}"
                                        Foreground="{DynamicResource Fs.Group.HeaderText}"
                                        BorderBrush="{DynamicResource Fs.Group.HeaderGlyph}"
                                        Effect="{DynamicResource Fs.Group.TitleEffect}"
                                        ToolTip="{Binding Texts[Icon.Choose], RelativeSource={RelativeSource AncestorType=local:MainView}}"
                                        AutomationProperties.Name="{Binding Texts[Icon.Choose], RelativeSource={RelativeSource AncestorType=local:MainView}}"
                                        Visibility="{Binding CustomizeVisibility, ElementName=Root}"
                                        Click="OnIconClick" />

                                <!-- The name: only its text is the rename target, the rest of the header still collapses. -->
                                <Grid VerticalAlignment="Center">
                                    <layout:TextRoom x:Name="NameRoom"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsRenaming, Converter={StaticResource Fs.InverseBoolToVisibility}}">
                                        <TextBlock x:Name="NameText"
                                                   Text="{Binding Title, ElementName=Root}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{DynamicResource Fs.Group.TitleFontSize}"
                                                   Foreground="{DynamicResource Fs.Group.HeaderText}"
                                                   Effect="{DynamicResource Fs.Group.TitleEffect}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </layout:TextRoom>
                                    <TextBox x:Name="RenameBox"
                                             Style="{StaticResource Fs.RenameBox}"
                                             Margin="-4,-3,0,-3"
                                             FontWeight="SemiBold"
                                             FontSize="{DynamicResource Fs.Group.TitleFontSize}"
                                             local:InlineRename.IsActive="{Binding IsRenaming, Mode=OneWay}"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource Fs.BoolToVisibility}}" />
                                </Grid>
                            </DockPanel>

                            <!-- The number of items: while collapsed, and always in Customize mode. -->
                            <Border Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Padding="7,2,7,3"
                                    CornerRadius="9"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Fs.Group.CountBackground}"
                                    Visibility="{Binding CountVisibility, ElementName=Root}">
                                <TextBlock Text="{Binding Count}"
                                           FontSize="11.2"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fs.Group.CountText}" />
                            </Border>

                            <!-- Customize mode: the color dot that opens the palette. -->
                            <Button x:Name="ColorDot"
                                    Grid.Column="4"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource Fs.ColorDotButton}"
                                    Click="OnColorDotClick"
                                    ToolTip="{Binding Texts[Group.Color], RelativeSource={RelativeSource AncestorType=local:MainView}}"
                                    AutomationProperties.Name="{Binding Texts[Group.Color], RelativeSource={RelativeSource AncestorType=local:MainView}}"
                                    Visibility="{Binding CustomizeVisibility, ElementName=Root}" />

                            <!-- Customize mode: ✕ deletes the group (the view model asks first when it holds items). -->
                            <Button Grid.Column="5"
                                    Margin="5,0,-4,0"
                                    Style="{StaticResource Fs.RemoveButton}"
                                    Foreground="{DynamicResource Fs.Group.HeaderGlyph}"
                                    Command="{Binding DataContext.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=local:MainView}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Texts[Group.Remove], RelativeSource={RelativeSource AncestorType=local:MainView}}"
                                    AutomationProperties.Name="{Binding Texts[Group.Remove], RelativeSource={RelativeSource AncestorType=local:MainView}}"
                                    Visibility="{Binding CustomizeVisibility, ElementName=Root}" />
                        </Grid>
                    </Border>

                    <!-- Collapsed, the items take no height. -->
                    <layout:CollapsibleBox IsCollapsed="{Binding IsCollapsed, ElementName=Root}">
                        <StackPanel>
                            <ItemsControl x:Name="ItemsList" ItemsSource="{Binding Items}" Focusable="False" Margin="5" MinHeight="12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:ItemView />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Customize mode: what adds an item. -->
                            <Button x:Name="AddButton"
                                    Margin="6,0,6,7"
                                    Style="{StaticResource Fs.AddItemButton}"
                                    Visibility="{Binding CustomizeVisibility, ElementName=Root}"
                                    Click="OnAddClick">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource Fs.OutlineIcon}"
                                                  Data="{StaticResource Fs.AddCircleGeometry}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Texts[AddMenu.Button], RelativeSource={RelativeSource AncestorType=local:MainView}, Mode=OneWay}" />
                                        <Run Text="▾" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </layout:CollapsibleBox>
                </DockPanel>

                <Border CornerRadius="{DynamicResource Fs.GroupRadius}"
                        BorderBrush="{DynamicResource Fs.Group.Frame}"
                        BorderThickness="{DynamicResource Fs.Group.FrameThickness}"
                        IsHitTestVisible="False" />

                <!-- Over the frame: a colored edge is the group's outermost line, as in the mockups. -->
                <Rectangle Width="{DynamicResource Fs.Group.LeftAccentWidth}"
                           HorizontalAlignment="Left"
                           Fill="{DynamicResource Fs.Group.Accent}"
                           IsHitTestVisible="False" />
                <Rectangle Height="{DynamicResource Fs.Group.TopAccentHeight}"
                           VerticalAlignment="Top"
                           Fill="{DynamicResource Fs.Group.Accent}"
                           IsHitTestVisible="False" />
            </Grid>
        </layout:RoundedClip>
    </Grid>
</UserControl>
