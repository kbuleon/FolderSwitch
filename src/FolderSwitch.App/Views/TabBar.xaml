<!--
    The tabs of MainViewModel.Tabs, the active one bold and underlined. A click shows a tab (the view model records it);
    Tab and Shift+Tab are handled by the window.
    Customize mode: a click also selects the tab (F2 renames it), a double-click on it renames it in place, it can be
    dragged along the bar (an insertion line shows where it goes), ✕ deletes it and « + » at the end adds one.
    Tabs that do not fit in the width of the window (bounded by the screen's work area) wrap onto further lines, and
    « + » follows them (beside the last line when there is room, else under it): every tab and « + » stay in reach.
    The bar's hairline lies under the tabs, in the same cell: the active tab's underline, drawn at the bottom of the tab,
    covers it as in the mockups, without reaching outside the tab (which layout rounding would clip); on a tab of an
    upper line it simply underlines the tab.
-->
<UserControl x:Class="FolderSwitch.App.Views.TabBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderSwitch.App.Views"
             xmlns:layout="clr-namespace:FolderSwitch.App.Views.Layout"
             x:Name="Root">
    <Grid Margin="0,0,0,9">
        <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Fs.Border}" />
        <WrapPanel Orientation="Horizontal" Margin="16,0">
            <ItemsControl x:Name="TabsList"
                          ItemsSource="{Binding Tabs}"
                          Background="Transparent"
                          Focusable="False"
                          AllowDrop="{Binding IsCustomizing}"
                          DragEnter="OnDragOver"
                          DragOver="OnDragOver"
                          DragLeave="OnDragLeave"
                          Drop="OnDrop">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <!-- The gap between two tabs. -->
                        <Setter Property="Margin" Value="0,0,2,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource Fs.TabSurface}" Loaded="OnTabLoaded">
                            <StackPanel Orientation="Horizontal">
                                <Grid VerticalAlignment="Center">
                                    <layout:TextRoom MaxWidth="220"
                                                     Visibility="{Binding IsRenaming, Converter={StaticResource Fs.InverseBoolToVisibility}}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </layout:TextRoom>
                                    <TextBox Style="{StaticResource Fs.RenameBox}"
                                             MaxWidth="220"
                                             Margin="-4,-3,-4,-3"
                                             FontSize="13.1"
                                             FontWeight="SemiBold"
                                             local:InlineRename.IsActive="{Binding IsRenaming, Mode=OneWay}"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource Fs.BoolToVisibility}}" />
                                </Grid>
                                <Button Style="{StaticResource Fs.RemoveButton}"
                                        Margin="6,0,-6,0"
                                        Foreground="{DynamicResource Fs.OnBackgroundMuted}"
                                        Command="{Binding DataContext.RemoveTabCommand, RelativeSource={RelativeSource AncestorType=local:MainView}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Texts[Tab.Remove], RelativeSource={RelativeSource AncestorType=local:MainView}}"
                                        AutomationProperties.Name="{Binding Texts[Tab.Remove], RelativeSource={RelativeSource AncestorType=local:MainView}}"
                                        Visibility="{Binding DataContext.IsCustomizing, RelativeSource={RelativeSource AncestorType=local:MainView}, Converter={StaticResource Fs.BoolToVisibility}}" />
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Level with the last line of tabs. -->
            <Button Style="{StaticResource Fs.AddTabButton}"
                    Margin="4,0,0,4"
                    VerticalAlignment="Bottom"
                    Command="{Binding AddTabCommand}"
                    ToolTip="{Binding Texts[Tab.Add], RelativeSource={RelativeSource AncestorType=local:MainView}}"
                    AutomationProperties.Name="{Binding Texts[Tab.Add], RelativeSource={RelativeSource AncestorType=local:MainView}}"
                    Visibility="{Binding IsCustomizing, Converter={StaticResource Fs.BoolToVisibility}}">
                <TextBlock Text="+" />
            </Button>
        </WrapPanel>
    </Grid>
</UserControl>
