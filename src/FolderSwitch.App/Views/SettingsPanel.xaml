<!--
    The settings panel (Customize mode, spec 5.4), bound to SettingsViewModel: the language (native names), the shortcut
    (the editor, then « Apply »), starting with Windows, export and import of the configuration, the update check
    (greyed out without one) and « About ». Every change takes effect at once. Shown in a Flyout under the ⚙ button of
    the title bar; while it is open the shortcut lands in the editor's test zone instead of hiding the window, and
    closing it ends any capture.
-->
<UserControl x:Class="FolderSwitch.App.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderSwitch.App.Views"
             x:Name="Root"
             Width="340">
    <StackPanel Margin="5,2,5,3">
        <TextBlock Margin="0,0,0,2" FontSize="14.5" FontWeight="SemiBold" Text="{Binding Texts[Window.Settings], ElementName=Root}" />

        <!-- Language -->
        <TextBlock Style="{StaticResource Fs.MenuLabel}" Margin="0,10,0,5" Text="{Binding Texts[Settings.Language], ElementName=Root, Converter={StaticResource Fs.UpperCase}}" />
        <ComboBox Style="{StaticResource Fs.ComboBox}"
                  ItemsSource="{Binding Languages}"
                  SelectedValuePath="Code"
                  SelectedValue="{Binding Language, Mode=TwoWay}"
                  AutomationProperties.Name="{Binding Texts[Settings.Language], ElementName=Root}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding NativeName}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Shortcut -->
        <TextBlock Style="{StaticResource Fs.MenuLabel}" Margin="0,12,0,5" Text="{Binding Texts[Settings.Hotkey], ElementName=Root, Converter={StaticResource Fs.UpperCase}}" />
        <local:HotkeyEditor x:Name="Editor" DataContext="{Binding Hotkey}" Texts="{Binding Texts, ElementName=Root}" />
        <Button Style="{StaticResource Fs.PrimaryButton}"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                Command="{Binding ApplyHotkeyCommand}">
            <TextBlock Text="{Binding Texts[Hotkey.Apply], ElementName=Root}" />
        </Button>

        <Border Height="1" Margin="0,12,0,10" Background="{DynamicResource Fs.Border}" />

        <!-- Startup -->
        <CheckBox Style="{StaticResource Fs.CheckBox}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}">
            <TextBlock Text="{Binding Texts[Settings.StartWithWindows], ElementName=Root}" TextWrapping="Wrap" />
        </CheckBox>

        <Border Height="1" Margin="0,10,0,10" Background="{DynamicResource Fs.Border}" />

        <!-- Configuration, updates -->
        <Button Style="{StaticResource Fs.PanelButton}" Command="{Binding ExportCommand}">
            <TextBlock Text="{Binding Texts[Settings.Export], ElementName=Root}" TextTrimming="CharacterEllipsis" />
        </Button>
        <Button Style="{StaticResource Fs.PanelButton}" Margin="0,6,0,0" Command="{Binding ImportCommand}">
            <TextBlock Text="{Binding Texts[Settings.Import], ElementName=Root}" TextTrimming="CharacterEllipsis" />
        </Button>
        <Button Style="{StaticResource Fs.PanelButton}" Margin="0,6,0,0" Command="{Binding CheckUpdatesCommand}">
            <TextBlock Text="{Binding Texts[Settings.Updates], ElementName=Root}" TextTrimming="CharacterEllipsis" />
        </Button>

        <!-- About -->
        <TextBlock Style="{StaticResource Fs.MenuLabel}" Margin="0,12,0,3" Text="{Binding Texts[Settings.About], ElementName=Root, Converter={StaticResource Fs.UpperCase}}" />
        <TextBlock Margin="0,0,0,2" FontSize="12.2" Foreground="{DynamicResource Fs.MenuMuted}">
            <Run Text="FolderSwitch" FontWeight="SemiBold" Foreground="{DynamicResource Fs.MenuText}" />
            <Run Text="·" />
            <Run Text="{Binding VersionText, ElementName=Root, Mode=OneWay}" />
        </TextBlock>
    </StackPanel>
</UserControl>
