<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- CsWin32 generates pointer-based interop code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Win32 interop source generator; the APIs it generates are listed in NativeMethods.txt. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FolderSwitch.Windows.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FolderSwitch.Core\FolderSwitch.Core.csproj" />
  </ItemGroup>

</Project>
