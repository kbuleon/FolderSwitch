<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FolderSwitch.Windows\FolderSwitch.Windows.csproj" />
    <!-- Built first, not referenced: the dialog tests start DialogHost.exe as a child process. -->
    <ProjectReference Include="..\DialogHost\DialogHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where DialogHost.exe is built (same configuration and target framework as this project). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DialogHostPath</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\DialogHost\bin\$(Configuration)\$(TargetFramework)\DialogHost.exe'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
