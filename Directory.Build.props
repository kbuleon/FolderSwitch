<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- The application's version (semantic versioning), bumped with every change of the software.
         build/pack.ps1 releases this version unless it is given another one. -->
    <Version>1.6.0</Version>
  </PropertyGroup>

</Project>
