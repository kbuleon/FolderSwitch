<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- The application's version, bumped by the agent once per work item (see Versioning in AGENTS.md).
         build/pack.ps1 releases this version unless it is given another one. -->
    <Version>0.1.1</Version>
  </PropertyGroup>

</Project>
